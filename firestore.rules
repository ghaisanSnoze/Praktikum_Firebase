rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidTransaction(data, transactionId) {
      return data.keys().hasAll([
            'transaction_id',
            'title',
            'amount',
            'type',
            'created_at'
          ]) &&
          data.keys().hasOnly([
            'transaction_id',
            'title',
            'amount',
            'type',
            'created_at'
          ]) &&
          data.transaction_id == transactionId &&
          data.title is string &&
          data.title.size() > 0 &&
          data.amount is int &&
          data.amount > 0 &&
          data.type in ['Pemasukan', 'Pengeluaran'] &&
          data.created_at is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['name', 'email', 'created_at']) &&
          request.resource.data.keys().hasOnly(['name', 'email', 'created_at']) &&
          request.resource.data.name is string &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.created_at is string;
      allow update, delete: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
            isValidTransaction(request.resource.data, transactionId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
